---
const links = [
  { href: '#services', label: '服务' },
  { href: '#process', label: '流程' },
  { href: '#about', label: '关于' },
  { href: '#contact', label: '联系' },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href="#top" aria-label="SolidSeq 首页">
      <span class="mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 64 64" fill="none">
          <rect x="14" y="18" width="36" height="6" rx="3" fill="#ffffff"/>
          <rect x="14" y="29" width="26" height="6" rx="3" fill="#ffffff" opacity=".85"/>
          <rect x="14" y="40" width="16" height="6" rx="3" fill="#ffffff" opacity=".7"/>
        </svg>
      </span>
      SolidSeq
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>
