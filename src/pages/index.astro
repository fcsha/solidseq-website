---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: '定制软件研发',
    desc: '面向业务需求定制开发管理系统、业务平台与内部工具，按项目整体交付。',
    icon: 'code',
  },
  {
    title: 'Web 应用开发',
    desc: '企业官网、管理后台与 SaaS 应用开发，注重性能与多端适配。',
    icon: 'globe',
  },
  {
    title: '移动应用开发',
    desc: 'iOS、Android 及跨平台应用开发，覆盖原型设计到发布上架。',
    icon: 'device',
  },
  {
    title: '系统集成与 API',
    desc: '系统对接、数据整合与接口开发，提供完善的接口文档。',
    icon: 'plug',
  },
  {
    title: '技术咨询与架构',
    desc: '技术选型、架构评审与性能优化，输出可执行的改进方案。',
    icon: 'compass',
  },
  {
    title: '维护与迭代',
    desc: '系统监控、缺陷修复与功能迭代，保障系统长期稳定运行。',
    icon: 'loop',
  },
];

const icons: Record<string, string> = {
  code: '<path d="M8 6 3 12l5 6M16 6l5 6-5 6"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  device: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>',
  plug: '<path d="M9 3v5M15 3v5M7 8h10v4a5 5 0 0 1-10 0V8zM12 17v4"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2z"/>',
  loop: '<path d="M17 2l4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
};

const scope = [
  { name: '定制软件研发', note: '管理系统 · 业务平台 · 内部工具' },
  { name: 'Web / 移动应用', note: '官网 · 管理后台 · App' },
  { name: '系统集成', note: '接口打通 · 数据整合' },
  { name: '技术咨询', note: '选型 · 架构 · 性能优化' },
  { name: '维护迭代', note: '监控 · 修复 · 功能演进' },
];

const steps = [
  { title: '需求梳理', desc: '明确业务目标与使用场景，输出需求范围与优先级。' },
  { title: '方案设计', desc: '制定技术方案、里程碑与报价，确认后启动开发。' },
  { title: '开发交付', desc: '按里程碑推进并定期同步进度，验收后部署上线。' },
  { title: '运维支持', desc: '提供维护与迭代支持，保障系统持续稳定运行。' },
];

const checklist = [
  '需求文档与优先级先行',
  '代码评审与自动化测试',
  '里程碑同步，进度透明',
  '交付附带部署与维护文档',
];
---

<Base
  title="SolidSeq · 软件定制开发服务商"
  description="SolidSeq 是专注软件定制开发的工程团队，为企业与团队提供定制软件研发、Web 与移动应用开发、系统集成、技术咨询及长期维护服务。"
>
  <Header />

  <main id="top">
    <!-- 英雄区 -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="tag">软件定制开发服务商</p>
          <h1>一站式软件定制开发服务</h1>
          <p class="lead">
            SolidSeq
            是专注软件定制开发的工程团队，为企业与团队提供从需求分析、方案设计到开发交付、运维迭代的完整服务，交付可维护、可演进的软件系统。
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#services">查看服务</a>
            <a class="btn btn-ghost" href="#contact">联系我们</a>
          </div>
          <p class="modes">
            <strong>服务模式：</strong>项目制开发 · 长期技术合作 · 技术顾问
          </p>
        </div>
        <aside class="scope-card" aria-label="服务范围">
          <h2>服务范围</h2>
          <ul>
            {
              scope.map((s) => (
                <li>
                  <span class="name">{s.name}</span>
                  <span class="note">{s.note}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <!-- 服务 -->
    <section class="block" id="services">
      <div class="container">
        <div class="block-head">
          <p class="kicker">服务内容</p>
          <h2>软件定制服务</h2>
          <p>
            覆盖软件定制开发的主要场景，可按项目整体交付，也可按长期合作方式推进。
          </p>
        </div>
        <div class="grid">
          {
            services.map((s) => (
              <div class="card">
                <span class="icon" aria-hidden="true">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={icons[s.icon]}
                  />
                </span>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 流程 -->
    <section class="block alt" id="process">
      <div class="container">
        <div class="block-head">
          <p class="kicker">合作流程</p>
          <h2>规范的四步协作</h2>
          <p>每一步都有明确的产出物，进度与风险随时同步。</p>
        </div>
        <div class="steps">
          {
            steps.map((s) => (
              <div class="step">
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 关于 -->
    <section class="block" id="about">
      <div class="container">
        <div class="block-head">
          <p class="kicker">关于我们</p>
          <h2>SolidSeq 团队</h2>
        </div>
        <div class="about-wrap">
          <div class="about-text">
            <h3>一支提供长期软件工程服务的定制开发团队</h3>
            <p>
              <strong>SolidSeq</strong>
              取名自 Solid（坚实）与 Sequence（序列）：好的软件来自一步步扎实的工程积累，而非一次性的堆砌。
            </p>
            <p>
              我们既写代码，也理解业务——先明确「为什么做」，再决定「怎么做」。所有项目坚持代码评审与自动化测试，交付物附带必要文档，便于客户团队接手与演进。
            </p>
          </div>
          <div class="checklist">
            <h3>我们如何工作</h3>
            <ul>
              {
                checklist.map((item) => (
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 联系 -->
    <section class="block alt" id="contact">
      <div class="container">
        <div class="contact-card">
          <div>
            <h2>联系我们</h2>
            <p>
              欢迎通过 GitHub 与我们联系，沟通需求、评估方案或了解合作方式。
            </p>
          </div>
          <div class="cta-row">
            <a
              class="btn btn-primary"
              href="https://github.com/fcsha"
              target="_blank"
              rel="noopener">
              在 GitHub 上找到我们
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
